<script>
// Global variables to store calculation results
let lastCalculation = null;

function calculateROI() {
  const postcode = document.getElementById("postcode").value;
  const quarterlyUse = +document.getElementById("quarterlyUse").value || 0;
  const usageRate = +document.getElementById("usageRate").value || 0;
  const supplyCharge = +document.getElementById("supplyCharge").value || 0;
  const currentSolar = +document.getElementById("currentSolar").value || 0;
  const feedInTariff = +document.getElementById("feedInTariff").value || 0;
  const plannedSolar = +document.getElementById("plannedSolar").value || 0;
  const batterySize = +document.getElementById("batterySize").value || 0;
  const systemCost = +document.getElementById("systemCost").value || 0;

  // Get radio button values
  const hasSolar = document.querySelector('input[name="hasSolar"]:checked').value;
  const addSolar = document.querySelector('input[name="addSolar"]:checked').value;

  // Basic validation
  if (!quarterlyUse || !usageRate || !batterySize || !systemCost) {
    alert("Please fill in all required fields marked with *.");
    return;
  }

  if (!postcode || postcode.length < 4) {
    alert("Please enter a valid 4-digit postcode.");
    return;
  }

  const cyclesPerDay = 1.0;
  const efficiency = 0.85;
  const solarGenerationFactor = 4; // kWh per kW of solar per day

  // Calculate savings
  const annualGridUse = quarterlyUse * 4;
  const annualBatteryEnergy = batterySize * 365 * cyclesPerDay * efficiency;
  const offsetEnergy = Math.min(annualGridUse, annualBatteryEnergy);
  
  // Additional solar savings if planning to add solar
  let solarSavings = 0;
  let solarGeneration = 0;
  if (plannedSolar > 0) {
    solarGeneration = plannedSolar * solarGenerationFactor * 365;
    solarSavings = Math.min(annualGridUse - offsetEnergy, solarGeneration) * usageRate;
  }

  const annualSavings = (offsetEnergy * usageRate) + solarSavings;
  const roi = (annualSavings / systemCost) * 100;
  const payback = annualSavings > 0 ? systemCost / annualSavings : 0;

  // Update display
  document.getElementById("savings").textContent =
    "$" + Math.round(annualSavings).toLocaleString();

  document.getElementById("roi").textContent =
    roi.toFixed(1) + "%";

  document.getElementById("payback").textContent =
    payback > 0 ? payback.toFixed(1) + " years" : "Never";

  // Show results
  const results = document.getElementById("results");
  results.style.display = "block";
  
  // Show download buttons
  const downloadButtons = document.getElementById("downloadButtons");
  downloadButtons.style.display = "flex";
  
  // Scroll to results
  results.scrollIntoView({ behavior: "smooth", block: "center" });

  // Store calculation for export
  lastCalculation = {
    postcode,
    quarterlyUse,
    usageRate,
    supplyCharge,
    currentSolar,
    feedInTariff,
    plannedSolar,
    batterySize,
    systemCost,
    hasSolar,
    addSolar,
    annualSavings,
    roi,
    payback,
    offsetEnergy,
    solarSavings,
    solarGeneration,
    timestamp: new Date().toLocaleString('en-AU', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    }),
    reportId: 'GS-' + Math.floor(100000 + Math.random() * 900000)
  };
}

