function generatePDF() {
  if (!lastCalculation) {
    alert("Please calculate your ROI first.");
    return;
  }

  // Update PDF template content
  document.getElementById("pdfDate").textContent = lastCalculation.timestamp;
  document.getElementById("pdfReportId").textContent = lastCalculation.reportId;
  document.getElementById("pdfReportId2").textContent = lastCalculation.reportId;
  document.getElementById("pdfCalcDate").textContent = lastCalculation.timestamp.split(' at ')[0];
  
  // Results section
  document.getElementById("pdfSavings").textContent = "$" + Math.round(lastCalculation.annualSavings).toLocaleString();
  document.getElementById("pdfROI").textContent = lastCalculation.roi.toFixed(1) + "%";
  document.getElementById("pdfPayback").textContent = lastCalculation.payback.toFixed(1) + " yrs";
  
  // Investment summary
  document.getElementById("pdfSystemCost").textContent = "$" + lastCalculation.systemCost.toLocaleString();
  document.getElementById("pdfBatterySize").textContent = lastCalculation.batterySize + " kWh";
  
  // Determine investment type and solar info
  let investmentType = "Battery Only";
  let solarSystemInfo = "None";
  
  if (lastCalculation.currentSolar > 0 && lastCalculation.plannedSolar > 0) {
    investmentType = "Battery + Existing Solar + Additional Solar";
    solarSystemInfo = lastCalculation.currentSolar + " kW (existing) + " + lastCalculation.plannedSolar + " kW (planned)";
  } else if (lastCalculation.currentSolar > 0) {
    investmentType = "Battery + Existing Solar";
    solarSystemInfo = lastCalculation.currentSolar + " kW (existing)";
  } else if (lastCalculation.plannedSolar > 0) {
    investmentType = "Battery + New Solar";
    solarSystemInfo = lastCalculation.plannedSolar + " kW (planned)";
  }
  
  document.getElementById("pdfInvestmentType").textContent = investmentType;
  document.getElementById("pdfSolarSystem").textContent = solarSystemInfo;
  
  // Explanation
  let explanation = `Based on your inputs, a ${lastCalculation.batterySize}kWh battery system `;
  if (lastCalculation.plannedSolar > 0) {
    explanation += `combined with ${lastCalculation.plannedSolar}kW of solar `;
  }
  explanation += `could save you approximately $${Math.round(lastCalculation.annualSavings)} annually. `;
  explanation += `This represents a ${lastCalculation.roi.toFixed(1)}% return on your investment, `;
  explanation += `with the system paying for itself in about ${lastCalculation.payback.toFixed(1)} years.`;
  document.getElementById("pdfExplanation1").textContent = explanation;
  
  // Input details
  document.getElementById("pdfPostcode").textContent = lastCalculation.postcode;
  document.getElementById("pdfQuarterlyUse").textContent = lastCalculation.quarterlyUse.toLocaleString() + " kWh";
  document.getElementById("pdfUsageRate").textContent = "$" + lastCalculation.usageRate.toFixed(4) + "/kWh";
  document.getElementById("pdfSupplyCharge").textContent = "$" + lastCalculation.supplyCharge.toFixed(2) + "/day";
  document.getElementById("pdfCurrentSolar").textContent = lastCalculation.currentSolar > 0 ? lastCalculation.currentSolar + " kW" : "None";
  document.getElementById("pdfFeedInTariff").textContent = lastCalculation.feedInTariff > 0 ? "$" + lastCalculation.feedInTariff.toFixed(4) + "/kWh" : "Not applicable";
  document.getElementById("pdfPlannedSolar").textContent = lastCalculation.plannedSolar > 0 ? lastCalculation.plannedSolar + " kW" : "None";

  // Show the PDF template
  const pdfTemplate = document.getElementById('pdfTemplate');
  pdfTemplate.style.display = 'block';
  
  // Generate PDF - Capture each page separately
  const { jsPDF } = window.jspdf;
  
  // Create a new PDF document
  const pdf = new jsPDF({
    orientation: 'portrait',
    unit: 'mm',
    format: 'a4'
  });
  
  // Set document properties
  pdf.setProperties({
    title: `Goldsure ROI Report - ${lastCalculation.postcode}`,
    subject: 'Battery & Solar Investment Analysis',
    author: 'Goldsure Pty Ltd',
    keywords: 'solar, battery, roi, investment, savings'
  });
  
  // Get both pages from the template
  const pages = pdfTemplate.querySelectorAll('.pdf-page');
  
  // Function to capture a single page and add it to the PDF
  const capturePage = (pageElement, pageNumber) => {
    return new Promise((resolve) => {
      html2canvas(pageElement, {
        scale: 1.5,
        useCORS: true,
        logging: false,
        backgroundColor: '#ffffff',
        width: pageElement.offsetWidth,
        height: pageElement.offsetHeight
      }).then(canvas => {
        const imgData = canvas.toDataURL('image/jpeg', 0.95);
        const imgWidth = 210; // A4 width in mm
        const imgHeight = (canvas.height * imgWidth) / canvas.width;
        
        if (pageNumber > 1) {
          pdf.addPage();
        }
        
        pdf.addImage(imgData, 'JPEG', 0, 0, imgWidth, imgHeight);
        resolve();
      });
    });
  };
  
  // Capture and add both pages sequentially
  Promise.all([
    capturePage(pages[0], 1),
    capturePage(pages[1], 2)
  ]).then(() => {
    // Save the PDF
    pdf.save(`Goldsure_ROI_Report_${lastCalculation.postcode}_${lastCalculation.reportId}.pdf`);
    
    // Hide the template again
    pdfTemplate.style.display = 'none';
  }).catch(error => {
    console.error('Error generating PDF:', error);
    alert('Error generating PDF. Please try again.');
    pdfTemplate.style.display = 'none';
  });
}

// Add some event listeners for better UX
document.addEventListener('DOMContentLoaded', function() {
  // Add input validation
  const numberInputs = document.querySelectorAll('input[type="number"]');
  numberInputs.forEach(input => {
    input.addEventListener('input', function() {
      if (this.value < 0) this.value = 0;
    });
  });
  
  // Radio button toggles
  document.querySelectorAll('input[name="hasSolar"]').forEach(radio => {
    radio.addEventListener('change', function() {
      const solarInput = document.getElementById('currentSolar');
      const feedInput = document.getElementById('feedInTariff');
      if (this.value === 'no') {
        solarInput.value = '';
        feedInput.value = '';
        solarInput.disabled = true;
        feedInput.disabled = true;
      } else {
        solarInput.disabled = false;
        feedInput.disabled = false;
      }
    });
  });
  
  document.querySelectorAll('input[name="addSolar"]').forEach(radio => {
    radio.addEventListener('change', function() {
      const solarInput = document.getElementById('plannedSolar');
      solarInput.disabled = this.value === 'no';
      if (this.value === 'no') solarInput.value = '';
    });
  });
  
  // Initialize disabled states
  document.getElementById('currentSolar').disabled = true;
  document.getElementById('feedInTariff').disabled = true;
});
</script>

