export default function handler(req, res) {
  const electrician = req.query.electrician || '';

  const startUrl = electrician
    ? `/smoke-alarms/calendar/?electrician=${encodeURIComponent(electrician)}`
    : '/smoke-alarms/calendar/';

  const manifest = {
    name: 'Goldsure Calendar',
    short_name: 'Goldsure',
    description: 'Goldsure electrician scheduling calendar',
    start_url: startUrl,
    display: 'standalone',
    background_color: '#0f172a',
    theme_color: '#c9a84c',
    orientation: 'portrait',
    icons: [
      {
        src: '/assets/icon-192x192.png',
        sizes: '192x192',
        type: 'image/png'
      },
      {
        src: '/assets/icon-512x512.png',
        sizes: '512x512',
        type: 'image/png'
      }
    ]
  };

  res.setHeader('Content-Type', 'application/manifest+json');
  res.setHeader('Cache-Control', 'no-store');
  res.status(200).json(manifest);
}
