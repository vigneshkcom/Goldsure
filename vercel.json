{
  "version": 2,
  "crons": [
    {
      "path": "/api/MetaAdPerformace/send-report",
      "schedule": "30 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/smoke-alarms/calculatorpdf.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ]
}
