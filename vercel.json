{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ringcentral/timeline",
      "destination": "/api/smoke-alarms/reports?rc=timeline"
    },
    {
      "source": "/api/ringcentral/missed",
      "destination": "/api/smoke-alarms/reports?rc=missed"
    },
    {
      "source": "/api/ringcentral/hourly-email",
      "destination": "/api/smoke-alarms/reports?rc=hourly-email"
    }
  ],
  "crons": [
    {
      "path": "/api/MetaAdPerformace/send-report",
      "schedule": "30 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/smoke-alarms/calculatorpdf.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ]
}
